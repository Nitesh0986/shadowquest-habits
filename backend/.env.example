# Copy this file to .env and fill it in:   cp .env.example .env
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shadowquest
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API (comma-separated). Vite's default is 5173.
CLIENT_ORIGIN=http://localhost:5173

# Streaks and "today" are calculated in the player's own timezone.
# New accounts use the timezone sent at signup, or this default if none is sent.
DEFAULT_TIMEZONE=UTC

# Max signup/login requests per IP per 15 minutes
AUTH_RATE_LIMIT=100
